<?xml version="1.0" encoding="utf-8"?>
<!--
  targetSdk 28, as Termux: apps targeting 29+ run in an SELinux domain that
  may not execute files they create, and UML starts its stub processes from
  an executable memfd (execveat). With 28 the kernel runs exactly as it does
  in Termux.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
>

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:extractNativeLibs="true"
        android:allowBackup="false"
        android:theme="@style/Theme.Uml">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".UmlService"
            android:exported="false" />
    </application>
</manifest>
