From 48da2cd29ec84b57d85045ff38984a52b3f0a58e Mon Sep 17 00:00:00 2001
From: UML Android <uml@localhost>
Date: Mon, 2 Nov 2026 20:05:17 +0000
Subject: [PATCH] um: optional idle polling to make cross-CPU wakeups cheap

An idle UML CPU sleeps in the host, so every wakeup from another CPU is an
IPI signal plus a host scheduler wakeup of the sleeping CPU thread. On
phones that host wakeup costs well over 100us. With idlepoll=<us> an idle
CPU first spins for that long with TIF_POLLING_NRFLAG set: wakers then just
set TIF_NEED_RESCHED (no signal), and the CPU thread is still running.
Pending host signals (timer, I/O) also end the poll.
---
 arch/um/include/asm/thread_info.h |  2 ++
 arch/um/include/shared/os.h       |  1 +
 arch/um/kernel/process.c          | 41 +++++++++++++++++++++++++++++++
 arch/um/os-Linux/signal.c         |  5 ++++
 4 files changed, 49 insertions(+)

diff --git a/arch/um/include/asm/thread_info.h b/arch/um/include/asm/thread_info.h
index 4ea15d678..88bfc9d05 100644
--- a/arch/um/include/asm/thread_info.h
+++ b/arch/um/include/asm/thread_info.h
@@ -46,6 +46,7 @@ struct thread_info {
 #define TIF_SECCOMP		9	/* secure computing */
 #define TIF_SINGLESTEP		10	/* single stepping userspace */
 #define TIF_SYSCALL_TRACEPOINT	11	/* syscall tracepoint instrumentation */
+#define TIF_POLLING_NRFLAG	12	/* idle is polling for TIF_NEED_RESCHED */
 
 
 #define _TIF_SYSCALL_TRACE	(1 << TIF_SYSCALL_TRACE)
@@ -57,6 +58,7 @@ struct thread_info {
 #define _TIF_NOTIFY_RESUME	(1 << TIF_NOTIFY_RESUME)
 #define _TIF_SECCOMP		(1 << TIF_SECCOMP)
 #define _TIF_SINGLESTEP		(1 << TIF_SINGLESTEP)
+#define _TIF_POLLING_NRFLAG	(1 << TIF_POLLING_NRFLAG)
 
 #define _TIF_WORK_MASK		(_TIF_NEED_RESCHED | _TIF_SIGPENDING | _TIF_NOTIFY_SIGNAL | \
 				 _TIF_NOTIFY_RESUME)
diff --git a/arch/um/include/shared/os.h b/arch/um/include/shared/os.h
index 8f30f2043..7ea5a6a3c 100644
--- a/arch/um/include/shared/os.h
+++ b/arch/um/include/shared/os.h
@@ -280,6 +280,7 @@ extern int os_timer_one_shot(int cpu, unsigned long long nsecs);
 extern void os_timer_disable(int cpu);
 extern long long os_persistent_clock_emulation(void);
 extern long long os_nsecs(void);
+extern int os_signals_pending(void);
 
 /* skas/mem.c */
 int syscall_stub_flush(struct mm_id *mm_idp);
diff --git a/arch/um/kernel/process.c b/arch/um/kernel/process.c
index 63b38a3f7..071df57bc 100644
--- a/arch/um/kernel/process.c
+++ b/arch/um/kernel/process.c
@@ -19,6 +19,7 @@
 #include <linux/slab.h>
 #include <linux/sched.h>
 #include <linux/sched/debug.h>
+#include <linux/sched/idle.h>
 #include <linux/sched/task.h>
 #include <linux/sched/task_stack.h>
 #include <linux/seq_file.h>
@@ -213,8 +214,48 @@ void um_idle_sleep(void)
 		os_idle_sleep();
 }
 
+/*
+ * idlepoll=<us>: before sleeping on the host, an idle CPU spins this long
+ * with TIF_POLLING_NRFLAG set. A wakeup from another CPU then only sets
+ * TIF_NEED_RESCHED instead of sending an IPI signal, and this CPU's host
+ * thread is still running, so it does not have to be woken by the host
+ * scheduler. That host wakeup is the expensive part of a cross-CPU wakeup
+ * (well over 100us on phones). Costs host CPU time while idle.
+ */
+static unsigned long idle_poll_ns;
+
+static int __init idle_poll_setup(char *str)
+{
+	unsigned long us;
+
+	if (kstrtoul(str, 0, &us))
+		return 0;
+	idle_poll_ns = us * NSEC_PER_USEC;
+	return 1;
+}
+__setup("idlepoll=", idle_poll_setup);
+
+/* Returns true if there is work, false if the poll window ran out. */
+static bool um_idle_poll(void)
+{
+	long long end = os_nsecs() + idle_poll_ns;
+	unsigned int n = 0;
+
+	if (!current_set_polling_and_test()) {
+		while (!tif_need_resched() && !os_signals_pending()) {
+			/* host clock reads are cheap but not free */
+			if (!(++n & 63) && os_nsecs() >= end)
+				break;
+			cpu_relax();
+		}
+	}
+	return current_clr_polling_and_test() || os_signals_pending();
+}
+
 void arch_cpu_idle(void)
 {
+	if (idle_poll_ns && time_travel_mode == TT_MODE_OFF && um_idle_poll())
+		return;
 	um_idle_sleep();
 }
 
diff --git a/arch/um/os-Linux/signal.c b/arch/um/os-Linux/signal.c
index 6c993bc8c..3fef55829 100644
--- a/arch/um/os-Linux/signal.c
+++ b/arch/um/os-Linux/signal.c
@@ -158,6 +158,11 @@ void timer_set_signal_handler(void)
 	set_handler(SIGALRM);
 }
 
+int os_signals_pending(void)
+{
+	return signals_pending != 0;
+}
+
 int timer_alarm_pending(void)
 {
 	return !!(signals_pending & SIGALRM_MASK);
-- 
