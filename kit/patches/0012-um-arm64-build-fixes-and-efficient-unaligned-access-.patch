From 6d1c766ebf43afa93a6e2683b507b1c71a87ec87 Mon Sep 17 00:00:00 2001
From: user <temp9040@gmail.com>
Date: Mon, 2 Nov 2026 10:14:36 +0000
Subject: [PATCH 12/12] um: arm64: build fixes and efficient unaligned access
 for Android

- An empty asm/text-patching.h: mm/execmem.c includes it once BPF_JIT
  is enabled; UML never patches kernel text.
- Select HAVE_EFFICIENT_UNALIGNED_ACCESS like arm64 itself: arm64 CPUs
  handle unaligned accesses, and without it the BPF verifier rejects
  Android's packet programs ("misaligned packet access"), so the BPF
  loader fails and Android reboots.
---
 arch/arm64/um/Kconfig             |  3 +++
 arch/arm64/um/asm/text-patching.h | 10 ++++++++++
 2 files changed, 13 insertions(+)
 create mode 100644 arch/arm64/um/asm/text-patching.h

diff --git a/arch/arm64/um/Kconfig b/arch/arm64/um/Kconfig
index d44ec76ab..3b6e64416 100644
--- a/arch/arm64/um/Kconfig
+++ b/arch/arm64/um/Kconfig
@@ -11,6 +11,9 @@ config UML_ARM64
 	select ARCH_USE_QUEUED_SPINLOCKS
 	select UML_SUBARCH_SUPPORTS_SMP
 	select UML_STUB_THREADS
+	# arm64 CPUs handle unaligned loads and stores; without this the BPF
+	# verifier rejects Android's packet programs (misaligned access).
+	select HAVE_EFFICIENT_UNALIGNED_ACCESS
 
 config 64BIT
 	def_bool y
diff --git a/arch/arm64/um/asm/text-patching.h b/arch/arm64/um/asm/text-patching.h
new file mode 100644
index 000000000..fbe8c9ede
--- /dev/null
+++ b/arch/arm64/um/asm/text-patching.h
@@ -0,0 +1,10 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef __UM_ARM64_TEXT_PATCHING_H
+#define __UM_ARM64_TEXT_PATCHING_H
+
+/*
+ * UML never patches kernel text at run time; this only satisfies
+ * <linux/text-patching.h> for code such as mm/execmem.c.
+ */
+
+#endif
