 arch/um/kernel/Makefile        |   1 +
 arch/um/kernel/bpf_jit_thunk.c | 182 +++++++++++++++++++++++++++++++++
 include/linux/filter.h         |   1 +
 kernel/bpf/core.c              |  17 +++
 5 files changed, 202 insertions(+)
