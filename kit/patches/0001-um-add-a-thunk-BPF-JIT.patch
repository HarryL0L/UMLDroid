diff --git a/kernel/bpf/core.c b/kernel/bpf/core.c
index 7f11555a5..e67e031b0 100644
--- a/kernel/bpf/core.c
+++ b/kernel/bpf/core.c
@@ -2490,6 +2490,23 @@ int bpf_patch_call_args(struct bpf_insn *insn, u32 stack_depth)
 	return 0;
 }
 
+/*
+ * Interpreter entry for a program with the given stack depth, callable as
+ * (r1, r2, r3, r4, r5, insns). Used by the User-Mode Linux thunk JIT.
+ */
+void *bpf_interp_args_entry(u32 stack_depth)
+{
+	int idx;
+
+	stack_depth = max_t(u32, stack_depth, 1);
+	if (stack_depth > MAX_BPF_STACK)
+		return NULL;
+	idx = (round_up(stack_depth, 32) / 32) - 1;
+	if (idx < 0 || idx >= ARRAY_SIZE(interpreters_args))
+		return NULL;
+	return (void *)interpreters_args[idx];
+}
+
 s32 bpf_call_args_imm(s16 idx)
 {
 	if (WARN_ON_ONCE(idx < 0 || idx >= ARRAY_SIZE(interpreters_args)))
