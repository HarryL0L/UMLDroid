From ca51a146961c3a368c2607840c6062b529260199 Mon Sep 17 00:00:00 2001
From: UML Android bring-up <uml@example.invalid>
Date: Sun, 1 Nov 2026 22:39:31 +0000
Subject: [PATCH 02/12] um: expose /proc/sys/vm/mmap_rnd_bits

Android init refuses to boot when the mmap_rnd_bits sysctl is missing.
Select HAVE_ARCH_MMAP_RND_BITS with the x86-64 ranges; UML does not
actually randomize the mmap base, the knob only has to exist.
---
 arch/um/Kconfig | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/arch/um/Kconfig b/arch/um/Kconfig
index d8e7c1dfe..d2027201d 100644
--- a/arch/um/Kconfig
+++ b/arch/um/Kconfig
@@ -22,6 +22,7 @@ config UML
 	select HAVE_ARCH_KASAN if X86_64
 	select HAVE_ARCH_KASAN_VMALLOC if HAVE_ARCH_KASAN
 	select HAVE_ARCH_SECCOMP_FILTER
+	select HAVE_ARCH_MMAP_RND_BITS
 	select HAVE_EBPF_JIT if 64BIT
 	select HAVE_ASM_MODVERSIONS
 	select HAVE_UID16
@@ -47,6 +48,16 @@ config UML
 	select SPARSE_IRQ
 	select MMU_GATHER_RCU_TABLE_FREE
 
+# Expose /proc/sys/vm/mmap_rnd_bits (Android's init requires it). The mmap
+# base is not actually randomized on UML, but the knob must exist.
+config ARCH_MMAP_RND_BITS_MIN
+	default 28 if 64BIT
+	default 8
+
+config ARCH_MMAP_RND_BITS_MAX
+	default 32 if 64BIT
+	default 16
+
 config MMU
 	bool
 	default y
