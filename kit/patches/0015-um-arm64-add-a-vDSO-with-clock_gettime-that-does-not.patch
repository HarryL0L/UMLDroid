+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Read a host clock for the vDSO (see vdso.c): this runs in the stub code
+ * page, from which the stub's seccomp filter allows host clock_gettime().
+ * int stub_vdso_clock_gettime(clockid_t clock, struct timespec *ts)
+ */
+#include <linux/linkage.h>
+#include <asm/unistd.h>
+
+	.section .__syscall_stub, "ax"
