diff --git a/arch/arm64/um/shared/sysdep/vvar.h b/arch/arm64/um/shared/sysdep/vvar.h
new file mode 100644
index 000000000..d014796f9
--- /dev/null
+++ b/arch/arm64/um/shared/sysdep/vvar.h
@@ -0,0 +1,31 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * Time data shared between the UML kernel and the arm64 UML vDSO. The vDSO
+ * reads the host's CLOCK_MONOTONIC through a function in the stub page (the
+ * host's seccomp filter only allows that syscall from there) and turns it
+ * into guest time exactly as the guest timekeeper does: host nanoseconds are
+ * the "timer" clocksource's cycles times 2^cycle_shift.
+ */
+#ifndef __UM_ARM64_VVAR_H
+#define __UM_ARM64_VVAR_H
+
+struct um_vvar_clock {
+	unsigned long long cycle_last;
+	unsigned long long mask;
+	unsigned int mult;
+	unsigned int shift;
+	long long base;			/* ns */
+	unsigned long long xtime_nsec;	/* ns << shift */
+};
+
+struct um_vvar {
+	unsigned int seq;		/* odd while being updated */
+	unsigned int enabled;		/* 0: use the syscall */
+	unsigned long long host_clock;	/* int (*)(clockid_t, struct timespec *) */
+	unsigned int cycle_shift;
+	unsigned int pad;
+	struct um_vvar_clock mono, raw;
+	long long offs_real, offs_boot, offs_tai;
+};
+
+#endif
