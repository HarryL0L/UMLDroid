+extern char um_vdso_start[], um_vdso_end[];
+extern char __syscall_stub_start[];
+extern void stub_vdso_clock_gettime(void);
 
-#define A64_MOVZ_X8(imm)	(0xd2800008u | ((u32)(imm) << 5))
-#define A64_SVC_0		0xd4000001u
-#define A64_BRK_0		0xd4200000u
+static int __init novdsoclock_setup(char *str)
+{
+	vdso_clock_disabled = true;
+	return 1;
+}
+__setup("novdsoclock", novdsoclock_setup);
 
-static int __init init_sigpage(void)
+/* Find a dynamic symbol of the vDSO image, as an offset into it */
+static unsigned long __init vdso_symbol(const char *name)
 {
-	u32 *code;
-	int i;
+	Elf64_Ehdr *eh = (void *)um_vdso_start;
+	Elf64_Shdr *sh = (void *)um_vdso_start + eh->e_shoff;
+	int i, j;
+
+	for (i = 0; i < eh->e_shnum; i++) {
+		Elf64_Sym *sym = (void *)um_vdso_start + sh[i].sh_offset;
+		const char *str;
+
+		if (sh[i].sh_type != SHT_DYNSYM)
+			continue;
+		str = (void *)um_vdso_start + sh[sh[i].sh_link].sh_offset;
+		for (j = 0; j < sh[i].sh_size / sizeof(*sym); j++)
+			if (!strcmp(str + sym[j].st_name, name))
+				return sym[j].st_value;
+	}
+	panic("vDSO symbol %s not found\n", name);
+}
+
+static int __init init_vdso(void)
+{
+	BUG_ON(um_vdso_end - um_vdso_start > PAGE_SIZE);
+	BUILD_BUG_ON(sizeof(struct um_vvar) > PAGE_SIZE);
 
 	um_vdso_addr = task_size - PAGE_SIZE;
 
-	um_sigpage = alloc_page(GFP_KERNEL);
-	if (!um_sigpage)
-		panic("Cannot allocate sigpage\n");
+	um_vdso_page = alloc_page(GFP_KERNEL | __GFP_ZERO);
+	um_vvar_page = alloc_page(GFP_KERNEL | __GFP_ZERO);
+	if (!um_vdso_page || !um_vvar_page)
+		panic("Cannot allocate vdso\n");
 
-	code = page_address(um_sigpage);
-	for (i = 0; i < PAGE_SIZE / sizeof(*code); i++)
-		code[i] = A64_BRK_0;
+	memcpy(page_address(um_vdso_page), um_vdso_start,
+	       um_vdso_end - um_vdso_start);
+	um_sigtramp_addr = um_vdso_addr + vdso_symbol("__kernel_rt_sigreturn");
 
-	/* __kernel_rt_sigreturn: mov x8, #__NR_rt_sigreturn; svc #0 */
-	code[0] = A64_MOVZ_X8(__NR_rt_sigreturn);
-	code[1] = A64_SVC_0;
+	um_vvar = page_address(um_vvar_page);
+	um_vvar->host_clock = STUB_CODE +
+		((unsigned long)stub_vdso_clock_gettime -
+		 (unsigned long)__syscall_stub_start);
+	um_vvar->cycle_shift = ilog2(TIMER_MULTIPLIER);
 
 	return 0;
 }
-subsys_initcall(init_sigpage);
+subsys_initcall(init_vdso);
+
+static void vvar_clock(struct um_vvar_clock *c, struct tk_read_base *tkr)
+{
+	c->cycle_last = tkr->cycle_last;
+	c->mask = tkr->mask;
+	c->mult = tkr->mult;
+	c->shift = tkr->shift;
+	c->base = ktime_to_ns(tkr->base);
+	c->xtime_nsec = tkr->xtime_nsec;
+}
+
+/* Called with the timekeeper locked whenever it changes (every tick) */
+static int vvar_update(struct notifier_block *nb, unsigned long was_set,
+		       void *priv)
+{
+	struct timekeeper *tk = priv;
+	struct um_vvar *v = um_vvar;
+
+	WRITE_ONCE(v->seq, v->seq + 1);
+	smp_wmb();
+
+	/* Only the host clock based clocksource can be read by the vDSO */
+	v->enabled = !vdso_clock_disabled && time_travel_mode == TT_MODE_OFF &&
+		     !strcmp(tk->tkr_mono.clock->name, "timer");
+	vvar_clock(&v->mono, &tk->tkr_mono);
+	vvar_clock(&v->raw, &tk->tkr_raw);
+	v->offs_real = ktime_to_ns(tk->offs_real);
+	v->offs_boot = ktime_to_ns(tk->offs_boot);
+	v->offs_tai = ktime_to_ns(tk->offs_tai);
+
+	smp_wmb();
+	WRITE_ONCE(v->seq, v->seq + 1);
+
+	return NOTIFY_OK;
+}
+
+static struct notifier_block vvar_notifier = {
+	.notifier_call = vvar_update,
+};
+
+static int __init init_vvar(void)
+{
+	return pvclock_gtod_register_notifier(&vvar_notifier);
+}
+device_initcall(init_vvar);
 
