diff --git a/arch/arm64/um/vdso/vdso.c b/arch/arm64/um/vdso/vdso.c
new file mode 100644
index 000000000..fb67232ef
--- /dev/null
+++ b/arch/arm64/um/vdso/vdso.c
@@ -0,0 +1,144 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * The vDSO of UML on arm64: clock_gettime() and gettimeofday() without
+ * trapping into UML. The host clock is read through the stub page and
+ * converted with the guest timekeeper's parameters from the vvar page (see
+ * sysdep/vvar.h). Everything else, and any clock not handled here, is a
+ * normal system call.
+ */
+#include <sysdep/vvar.h>
+
+#define CLOCK_REALTIME		0
+#define CLOCK_MONOTONIC		1
+#define CLOCK_MONOTONIC_RAW	4
+#define CLOCK_REALTIME_COARSE	5
+#define CLOCK_MONOTONIC_COARSE	6
+#define CLOCK_BOOTTIME		7
+#define CLOCK_TAI		11
+
+#define NR_gettimeofday		169
+#define NR_clock_gettime	113
+#define NR_clock_getres		114
+
+struct vdso_timespec { long tv_sec; long tv_nsec; };
+struct vdso_timeval { long tv_sec; long tv_usec; };
+
+/* The page before the vDSO, see vdso.lds.S */
+extern const struct um_vvar um_vvar __attribute__((visibility("hidden")));
+
+static inline long syscall2(long nr, long a, long b)
+{
+	register long x8 asm("x8") = nr;
+	register long x0 asm("x0") = a;
+	register long x1 asm("x1") = b;
+
+	asm volatile("svc #0" : "+r" (x0) : "r" (x8), "r" (x1) : "memory");
+	return x0;
+}
+
+static inline unsigned long long tk_ns(const struct um_vvar_clock *c,
+				       unsigned long long cycles, int coarse)
+{
+	unsigned long long d = coarse ? 0 : (cycles - c->cycle_last) & c->mask;
+
+	return c->base + ((d * c->mult + c->xtime_nsec) >> c->shift);
+}
+
+/* Guest time of @clk in ns, or -1 to use the system call */
+static long long guest_ns(int clk)
+{
+	const volatile struct um_vvar *v = &um_vvar;
+	struct vdso_timespec ts;
+	unsigned long long cycles, ns;
+	unsigned int seq;
+	int coarse = clk == CLOCK_REALTIME_COARSE || clk == CLOCK_MONOTONIC_COARSE;
+	long long off;
+
+	do {
+		seq = v->seq;
+		asm volatile("dmb ishld" ::: "memory");
+		if ((seq & 1) || !v->enabled)
+			return -1;
+		if (coarse) {
+			cycles = 0;
+		} else {
+			if (((int (*)(int, struct vdso_timespec *))v->host_clock)(CLOCK_MONOTONIC, &ts))
+				return -1;
+			cycles = ((unsigned long long)ts.tv_sec * 1000000000ULL +
+				  ts.tv_nsec) >> v->cycle_shift;
+		}
+		switch (clk) {
+		case CLOCK_MONOTONIC_RAW:
+			ns = tk_ns((const struct um_vvar_clock *)&v->raw, cycles, 0);
+			off = 0;
+			break;
+		case CLOCK_REALTIME:
+		case CLOCK_REALTIME_COARSE:
+			ns = tk_ns((const struct um_vvar_clock *)&v->mono, cycles, coarse);
+			off = v->offs_real;
+			break;
+		case CLOCK_BOOTTIME:
+			ns = tk_ns((const struct um_vvar_clock *)&v->mono, cycles, 0);
+			off = v->offs_boot;
+			break;
+		case CLOCK_TAI:
+			ns = tk_ns((const struct um_vvar_clock *)&v->mono, cycles, 0);
+			off = v->offs_tai;
+			break;
+		default:
+			ns = tk_ns((const struct um_vvar_clock *)&v->mono, cycles, coarse);
+			off = 0;
+			break;
+		}
+		asm volatile("dmb ishld" ::: "memory");
+	} while (v->seq != seq);
+
+	return ns + off;
+}
+
+static int handled(int clk)
+{
+	return clk == CLOCK_REALTIME || clk == CLOCK_MONOTONIC ||
+	       clk == CLOCK_MONOTONIC_RAW || clk == CLOCK_REALTIME_COARSE ||
+	       clk == CLOCK_MONOTONIC_COARSE || clk == CLOCK_BOOTTIME ||
+	       clk == CLOCK_TAI;
+}
+
+int __kernel_clock_gettime(int clk, struct vdso_timespec *ts)
+{
+	long long ns = handled(clk) ? guest_ns(clk) : -1;
+
+	if (ns < 0)
+		return syscall2(NR_clock_gettime, clk, (long)ts);
+	ts->tv_sec = ns / 1000000000LL;
+	ts->tv_nsec = ns % 1000000000LL;
+	return 0;
+}
+
+int __kernel_gettimeofday(struct vdso_timeval *tv, void *tz)
+{
+	long long ns;
+
+	if (tz || !tv)
+		return syscall2(NR_gettimeofday, (long)tv, (long)tz);
+	ns = guest_ns(CLOCK_REALTIME);
+	if (ns < 0)
+		return syscall2(NR_gettimeofday, (long)tv, (long)tz);
+	tv->tv_sec = ns / 1000000000LL;
+	tv->tv_usec = ns % 1000000000LL / 1000;
+	return 0;
+}
+
+int __kernel_clock_getres(int clk, struct vdso_timespec *res)
+{
+	return syscall2(NR_clock_getres, clk, (long)res);
+}
+
+/* Signal return trampoline (the kernel points the handler's LR here) */
+asm(".text\n"
+    ".globl __kernel_rt_sigreturn\n"
+    ".type __kernel_rt_sigreturn, %function\n"
+    "__kernel_rt_sigreturn:\n"
