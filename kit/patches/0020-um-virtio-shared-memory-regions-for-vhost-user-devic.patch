 			VHOST_USER_VERSION)
@@ -386,15 +408,16 @@ static irqreturn_t vu_req_read_message(struct virtio_uml_device *vu_dev,
 		struct vhost_user_msg msg;
 		u8 extra_payload[512];
 	} msg;
-	int rc;
+	int rc, fd;
 	irqreturn_t irq_rc = IRQ_NONE;
 
 	while (1) {
 		rc = vhost_user_recv_req(vu_dev, &msg.msg,
 					 sizeof(msg.msg.payload) +
-					 sizeof(msg.extra_payload));
+					 sizeof(msg.extra_payload), &fd);
 		if (rc)
