diff --git a/arch/um/kernel/physmem.c b/arch/um/kernel/physmem.c
index ae6ca373c..355eb62e5 100644
--- a/arch/um/kernel/physmem.c
+++ b/arch/um/kernel/physmem.c
@@ -7,6 +7,10 @@
 #include <linux/memblock.h>
 #include <linux/mm.h>
 #include <linux/pfn.h>
+#include <linux/sizes.h>
+#include <linux/slab.h>
+#include <linux/spinlock.h>
+#include <asm/shm_window.h>
 #include <asm/page.h>
 #include <asm/sections.h>
 #include <as-layout.h>
@@ -97,6 +101,132 @@ void __init setup_physmem(unsigned long start, unsigned long reserve_end,
 	max_low_pfn = min_low_pfn + (map_size >> PAGE_SHIFT);
 }
 
+struct um_shm_map {
+	unsigned long phys, len;
+	int fd;
+	unsigned long long fd_off;
+	void *kaddr;
+};
+
+/* Sorted by phys; read on every TLB sync of such a page, changed rarely */
+static struct um_shm_map *shm_maps;
+static unsigned int shm_n, shm_cap;
+static DEFINE_RWLOCK(shm_lock);
+static unsigned long shm_next = UM_SHM_PHYS_BASE;
+static DEFINE_SPINLOCK(shm_reserve_lock);
+
+/* Reserve a window of guest physical addresses (1 GiB aligned) */
+unsigned long um_shm_reserve(unsigned long len)
+{
+	unsigned long base;
+
+	spin_lock(&shm_reserve_lock);
+	base = ALIGN(shm_next, SZ_1G);
+	shm_next = base + ALIGN(len, SZ_1G);
+	spin_unlock(&shm_reserve_lock);
+	return base;
+}
+
+/* The mapping containing @phys, or the index to insert one at; under shm_lock */
+static struct um_shm_map *shm_find(unsigned long phys, unsigned int *pos)
+{
+	unsigned int lo = 0, hi = shm_n;
+
+	while (lo < hi) {
+		unsigned int mid = (lo + hi) / 2;
+		struct um_shm_map *m = &shm_maps[mid];
+
+		if (phys < m->phys)
+			hi = mid;
+		else if (phys >= m->phys + m->len)
+			lo = mid + 1;
+		else
+			return m;
+	}
+	if (pos)
+		*pos = lo;
+	return NULL;
+}
+
+/* Map @len bytes of @fd at @fd_off at guest physical @phys; takes over @fd */
+int um_shm_map(unsigned long phys, unsigned long len, int fd,
+	       unsigned long long fd_off, bool writable)
+{
+	unsigned long flags;
+	unsigned int pos;
+	void *kaddr;
+	int err = 0;
+
+	if (phys < UM_SHM_PHYS_BASE || !len || (phys | len | fd_off) & ~PAGE_MASK)
+		return -EINVAL;
+	kaddr = os_map_fd_shared(fd, fd_off, len, writable);
+	if (!kaddr)
+		return -ENOMEM;
+
+	write_lock_irqsave(&shm_lock, flags);
+	if (shm_find(phys, &pos) || shm_find(phys + len - 1, NULL) ||
+	    (pos < shm_n && shm_maps[pos].phys < phys + len)) {
+		err = -EEXIST;
+		goto out;
+	}
+	if (shm_n == shm_cap) {
+		unsigned int cap = shm_cap ? 2 * shm_cap : 64;
+		struct um_shm_map *n = krealloc_array(shm_maps, cap, sizeof(*n), GFP_ATOMIC);
+
+		if (!n) {
+			err = -ENOMEM;
+			goto out;
+		}
+		shm_maps = n;
+		shm_cap = cap;
+	}
+	memmove(&shm_maps[pos + 1], &shm_maps[pos], (shm_n - pos) * sizeof(*shm_maps));
+	shm_maps[pos] = (struct um_shm_map){ phys, len, fd, fd_off, kaddr };
+	shm_n++;
+out:
+	write_unlock_irqrestore(&shm_lock, flags);
+	if (err)
+		os_unmap_memory(kaddr, len);
+	return err;
+}
+
+/* Undo um_shm_map(): the guest must not have the range mapped any more */
+int um_shm_unmap(unsigned long phys, unsigned long len)
+{
+	struct um_shm_map m, *p;
+	unsigned long flags;
+
+	write_lock_irqsave(&shm_lock, flags);
+	p = shm_find(phys, NULL);
+	if (!p || p->phys != phys || p->len != len) {
+		write_unlock_irqrestore(&shm_lock, flags);
+		return -ENOENT;
+	}
+	m = *p;
+	memmove(p, p + 1, (shm_n - (p - shm_maps) - 1) * sizeof(*p));
+	shm_n--;
+	write_unlock_irqrestore(&shm_lock, flags);
+
+	os_unmap_memory(m.kaddr, m.len);
+	os_close_file(m.fd);
+	return 0;
+}
+
+/* The kernel's mapping of a shared memory page, for user copies */
+void *um_shm_kaddr(unsigned long phys)
+{
+	struct um_shm_map *m;
+	unsigned long flags;
+	void *k = NULL;
+
+	read_lock_irqsave(&shm_lock, flags);
+	m = shm_find(phys, NULL);
+	if (m)
+		k = m->kaddr + (phys - m->phys);
+	read_unlock_irqrestore(&shm_lock, flags);
+	return k;
+}
+
 int phys_mapping(unsigned long phys, unsigned long long *offset_out)
 {
 	int fd = -1;
@@ -104,10 +234,27 @@ int phys_mapping(unsigned long phys, unsigned long long *offset_out)
 	if (phys < physmem_size) {
 		fd = physmem_fd;
 		*offset_out = phys;
+	} else if (phys >= UM_SHM_PHYS_BASE) {
+		struct um_shm_map *m;
+		unsigned long flags;
+
+		read_lock_irqsave(&shm_lock, flags);
+		m = shm_find(phys, NULL);
+		if (m) {
+			fd = m->fd;
+			*offset_out = m->fd_off + (phys - m->phys);
+		}
+		read_unlock_irqrestore(&shm_lock, flags);
 	}
 
 	return fd;
 }
+
+/* The RAM file: the only memory FD worth keeping open in stub processes */
+int um_physmem_fd(void)
+{
+	return physmem_fd;
+}
 EXPORT_SYMBOL(phys_mapping);
 
 static int __init uml_mem_setup(char *line, int *add)
diff --git a/arch/um/kernel/skas/uaccess.c b/arch/um/kernel/skas/uaccess.c
index caef1deef..f19dc2466 100644
--- a/arch/um/kernel/skas/uaccess.c
+++ b/arch/um/kernel/skas/uaccess.c
@@ -10,6 +10,7 @@
 #include <linux/sched.h>
 #include <asm/current.h>
 #include <asm/page.h>
+#include <asm/shm_window.h>
 #include <kern_util.h>
 #include <asm/futex.h>
 #include <os.h>
@@ -72,6 +73,18 @@ static int do_op_one_page(unsigned long addr, int len, int is_write,
 	if (pte == NULL)
 		return -1;
 
+	/* Not RAM: a shared memory window (e.g. virtio-gpu host memory) */
+	if (!pfn_valid(pte_pfn(*pte))) {
+		void *k = um_shm_kaddr(pte_pfn(*pte) << PAGE_SHIFT);
+
+		if (!k)
+			return -1;
+		pagefault_disable();
+		n = (*op)((unsigned long)k + (addr & ~PAGE_MASK), len, arg);
+		pagefault_enable();
+		return n;
+	}
+
 	page = pte_page(*pte);
 #ifdef CONFIG_64BIT
 	pagefault_disable();
