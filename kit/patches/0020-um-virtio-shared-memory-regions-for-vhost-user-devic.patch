 #include <linux/virtio_ring.h>
 #include <linux/time-internal.h>
 #include <linux/virtio-uml.h>
@@ -58,6 +59,11 @@ struct virtio_uml_device {
 	int sock, req_fd, irq;
 	u64 features;
 	u64 protocol_features;
+
+	/* virtio shared memory regions (VHOST_USER_PROTOCOL_F_SHMEM) */
+#define VU_MAX_SHM	8
+	unsigned int n_shm;
+	u64 shm_base[VU_MAX_SHM], shm_len[VU_MAX_SHM];
 	u64 max_vqs;
 	u8 status;
 	u8 registered:1;
@@ -209,13 +215,29 @@ static int vhost_user_recv_u64(struct virtio_uml_device *vu_dev,
 
 static int vhost_user_recv_req(struct virtio_uml_device *vu_dev,
 			       struct vhost_user_msg *msg,
-			       size_t max_payload_size)
+			       size_t max_payload_size, int *fd)
 {
-	int rc = vhost_user_recv(vu_dev, vu_dev->req_fd, msg,
-				 max_payload_size, false);
+	ssize_t n;
+	int rc;
 
-	if (rc)
+	/* recvmsg for the header: a SHMEM_MAP request carries an fd */
+	*fd = -1;
+	n = os_rcv_fd_msg(vu_dev->req_fd, fd, 1, msg, sizeof(msg->header));
+	if (n < 0)
+		return n;
