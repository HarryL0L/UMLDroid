@@ -107,12 +112,32 @@ struct vhost_user_mem_regions {
 	struct vhost_user_mem_region regions[2]; /* Currently supporting 2 */
 } __packed;
 
+/* VHOST_USER_GET_SHMEM_CONFIG reply */
+#define VHOST_USER_MAX_SHMEM_REGIONS	256
+struct vhost_user_shmem_config {
+	u32 nregions;
+	u32 padding;
+	u64 memory_sizes[VHOST_USER_MAX_SHMEM_REGIONS];
+} __packed;
+
+/* VHOST_USER_SLAVE_SHMEM_MAP / _UNMAP, the fd comes with _MAP */
+#define VHOST_USER_FLAG_MAP_RW		BIT(0)
+struct vhost_user_mmap {
+	u8 shmid;
+	u8 padding[7];
+	u64 fd_offset;
+	u64 shm_offset;
+	u64 len;
+	u64 flags;
+} __packed;
+
 union vhost_user_payload {
 	u64 integer;
 	struct vhost_user_config config;
 	struct vhost_user_vring_state vring_state;
 	struct vhost_user_vring_addr vring_addr;
 	struct vhost_user_mem_regions mem_regions;
+	struct vhost_user_mmap mmap;
 };
 
