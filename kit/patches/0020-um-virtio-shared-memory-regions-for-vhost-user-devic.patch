+		response = 1;
 
 		switch (msg.msg.header.request) {
 		case VHOST_USER_SLAVE_CONFIG_CHANGE_MSG:
@@ -410,6 +433,30 @@ static irqreturn_t vu_req_read_message(struct virtio_uml_device *vu_dev,
 				}
 			}
 			break;
+		case VHOST_USER_SLAVE_SHMEM_MAP:
+		case VHOST_USER_SLAVE_SHMEM_UNMAP: {
+			struct vhost_user_mmap *m = &msg.msg.payload.mmap;
+			bool map = msg.msg.header.request == VHOST_USER_SLAVE_SHMEM_MAP;
+
+			if (m->shmid >= vu_dev->n_shm || !m->len ||
+			    m->shm_offset + m->len > vu_dev->shm_len[m->shmid] ||
+			    m->shm_offset + m->len < m->len || (map && fd < 0)) {
+				vu_err(vu_dev, "invalid shmem request %d\n",
+				       msg.msg.header.request);
+				break;
