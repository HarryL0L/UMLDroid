  * process outside UML can see what the kernel writes there. Returns NULL
  * on failure.
  */
+/* Map @len bytes of @fd at @off shared into the kernel's address space */
+void *os_map_fd_shared(int fd, unsigned long long off, unsigned long len, int writable)
+{
+	void *p = mmap(NULL, len, PROT_READ | (writable ? PROT_WRITE : 0), MAP_SHARED,
+		       fd, off);
+
+	return p == MAP_FAILED ? NULL : p;
+}
+
 void *os_map_shared_file(const char *path, unsigned long size)
 {
 	void *p;
diff --git a/arch/um/os-Linux/skas/mem.c b/arch/um/os-Linux/skas/mem.c
