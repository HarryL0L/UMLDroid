 arch/um/drivers/virtio_uml.c     | 121 +++++++++++++++++++++++--
 arch/um/include/asm/shm_window.h |  19 ++++
 arch/um/include/shared/os.h      |   3 +
 arch/um/kernel/physmem.c         | 147 +++++++++++++++++++++++++++++++
 arch/um/kernel/skas/uaccess.c    |  13 +++
