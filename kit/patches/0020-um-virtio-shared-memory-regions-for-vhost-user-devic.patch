 		case VHOST_USER_SLAVE_VRING_HOST_NOTIFIER_MSG:
@@ -422,6 +469,8 @@ static irqreturn_t vu_req_read_message(struct virtio_uml_device *vu_dev,
 		if (ev && !vu_dev->suspended)
 			time_travel_add_irq_event(ev);
 
+		if (fd >= 0)
+			os_close_file(fd);
 		if (msg.msg.header.flags & VHOST_USER_FLAG_NEED_REPLY)
 			vhost_user_reply(vu_dev, &msg.msg, response);
 		irq_rc = IRQ_HANDLED;
@@ -499,6 +548,46 @@ static int vhost_user_init_slave_req(struct virtio_uml_device *vu_dev)
 	return rc;
 }
 
+/* Sizes of the shared memory regions; reserve guest physical windows */
+static int vhost_user_get_shmem_config(struct virtio_uml_device *vu_dev)
+{
+	struct {
+		struct vhost_user_msg msg;
+		struct vhost_user_shmem_config cfg;
+	} *r;
+	struct vhost_user_shmem_config *cfg;
+	int rc;
+
+	rc = vhost_user_send_no_payload(vu_dev, true, VHOST_USER_GET_SHMEM_CONFIG);
+	if (rc)
+		return rc;
+	r = kzalloc(sizeof(*r), GFP_KERNEL);
+	if (!r)
+		return -ENOMEM;
+	rc = vhost_user_recv_resp(vu_dev, &r->msg, sizeof(r->msg.payload) + sizeof(r->cfg));
+	if (rc)
+		goto out;
+	rc = -EPROTO;
+	if (r->msg.header.request != VHOST_USER_GET_SHMEM_CONFIG ||
+	    r->msg.header.size < 8)
+		goto out;
+	cfg = (void *)&r->msg.payload;
+	vu_dev->n_shm = min_t(u32, cfg->nregions, VU_MAX_SHM);
+	for (unsigned int i = 0; i < vu_dev->n_shm; i++) {
+		u64 len = PAGE_ALIGN(cfg->memory_sizes[i]);
+
+		vu_dev->shm_len[i] = len;
+		vu_dev->shm_base[i] = len ? um_shm_reserve(len) : 0;
+		if (len)
+			dev_info(&vu_dev->pdev->dev, "shared memory region %u: %llu MiB at 0x%llx\n",
+				i, len >> 20, vu_dev->shm_base[i]);
+	}
+	rc = 0;
+out:
+	kfree(r);
+	return rc;
+}
+
 static int vhost_user_init(struct virtio_uml_device *vu_dev)
 {
 	int rc = vhost_user_set_owner(vu_dev);
@@ -528,6 +617,13 @@ static int vhost_user_init(struct virtio_uml_device *vu_dev)
 			return rc;
 	}
 
+	if (vu_dev->protocol_features &
+			BIT_ULL(VHOST_USER_PROTOCOL_F_SHMEM)) {
+		rc = vhost_user_get_shmem_config(vu_dev);
+		if (rc)
+			return rc;
+	}
+
 	if (vu_dev->protocol_features &
 			BIT_ULL(VHOST_USER_PROTOCOL_F_MQ)) {
 		rc = vhost_user_get_queue_num(vu_dev, &vu_dev->max_vqs);
@@ -1113,7 +1209,20 @@ static const char *vu_bus_name(struct virtio_device *vdev)
 	return vu_dev->pdev->name;
 }
 
+static bool vu_get_shm_region(struct virtio_device *vdev,
+			      struct virtio_shm_region *region, u8 id)
+{
+	struct virtio_uml_device *vu_dev = to_virtio_uml_device(vdev);
+
+	if (id >= vu_dev->n_shm || !vu_dev->shm_len[id])
+		return false;
+	region->addr = vu_dev->shm_base[id];
+	region->len = vu_dev->shm_len[id];
+	return true;
+}
+
 static const struct virtio_config_ops virtio_uml_config_ops = {
+	.get_shm_region = vu_get_shm_region,
 	.get = vu_get,
 	.set = vu_set,
 	.get_status = vu_get_status,
diff --git a/arch/um/include/asm/shm_window.h b/arch/um/include/asm/shm_window.h
new file mode 100644
index 000000000..218542fa5
--- /dev/null
+++ b/arch/um/include/asm/shm_window.h
@@ -0,0 +1,19 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef __UM_SHM_WINDOW_H
+#define __UM_SHM_WINDOW_H
+
+#include <linux/types.h>
+
+/*
+ * Shared memory windows: guest physical ranges above RAM that map host files
+ * passed by vhost-user backends (virtio shared memory regions).
+ */
+#define UM_SHM_PHYS_BASE	(1UL << 40)
+
+unsigned long um_shm_reserve(unsigned long len);
+int um_shm_map(unsigned long phys, unsigned long len, int fd,
+	       unsigned long long fd_off, bool writable);
+int um_shm_unmap(unsigned long phys, unsigned long len);
+void *um_shm_kaddr(unsigned long phys);
+
+#endif
