 drivers/gpu/drm/vkms/vkms_composer.c  |  31 ++++++--
 drivers/gpu/drm/vkms/vkms_connector.c |  24 ++++++
 drivers/gpu/drm/vkms/vkms_crtc.c      |   5 +-
 drivers/gpu/drm/vkms/vkms_drv.h       |   1 +
 drivers/gpu/drm/vkms/vkms_export.c    | 103 ++++++++++++++++++++++++++
 drivers/gpu/drm/vkms/vkms_export.h    |  25 +++++++
 7 files changed, 184 insertions(+), 7 deletions(-)
 create mode 100644 drivers/gpu/drm/vkms/vkms_export.c
 create mode 100644 drivers/gpu/drm/vkms/vkms_export.h

