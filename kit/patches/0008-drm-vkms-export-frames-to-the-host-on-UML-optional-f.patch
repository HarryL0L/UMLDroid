diff --git a/drivers/gpu/drm/vkms/vkms_composer.c b/drivers/gpu/drm/vkms/vkms_composer.c
index 83d217085..12b5fde21 100644
--- a/drivers/gpu/drm/vkms/vkms_composer.c
+++ b/drivers/gpu/drm/vkms/vkms_composer.c
@@ -16,6 +16,7 @@
 
 #include "vkms_composer.h"
 #include "vkms_luts.h"
+#include "vkms_export.h"
 
 static u16 pre_mul_blend_channel(u16 src, u16 dst, u16 alpha)
 {
@@ -471,7 +472,8 @@ static void blend_line(struct vkms_plane_state *current_plane, int y,
 static void blend(struct vkms_writeback_job *wb,
 		  struct vkms_crtc_state *crtc_state,
 		  u32 *crc32, struct line_buffer *stage_buffer,
-		  struct line_buffer *output_buffer, size_t row_size)
+		  struct line_buffer *output_buffer, size_t row_size,
+		  u8 *export_pixels)
 {
 	struct vkms_plane_state **plane = crtc_state->active_planes;
 	u32 n_active_planes = crtc_state->num_active_planes;
@@ -508,6 +510,9 @@ static void blend(struct vkms_writeback_job *wb,
 
 		if (wb)
 			vkms_writeback_row(wb, output_buffer, y);
+
+		if (export_pixels)
+			vkms_export_row(export_pixels, crtc_x_limit, y, output_buffer);
 	}
 }
 
@@ -541,8 +546,9 @@ static int check_iosys_map(struct vkms_crtc_state *crtc_state)
 
 static int compose_active_planes(struct vkms_writeback_job *active_wb,
 				 struct vkms_crtc_state *crtc_state,
-				 u32 *crc32)
+				 u32 *crc32, bool export)
 {
+	u8 *export_pixels = NULL;
 	size_t line_width, pixel_size = sizeof(struct pixel_argb_u16);
 	struct line_buffer output_buffer, stage_buffer;
 	int ret = 0;
@@ -578,8 +584,15 @@ static int compose_active_planes(struct vkms_writeback_job *active_wb,
 		goto free_stage_buffer;
 	}
 
+	if (export)
+		export_pixels = vkms_export_begin(line_width,
+						  crtc_state->base.mode.vdisplay);
+
 	blend(active_wb, crtc_state, crc32, &stage_buffer,
-	      &output_buffer, line_width * pixel_size);
+	      &output_buffer, line_width * pixel_size, export_pixels);
+
+	if (export_pixels)
+		vkms_export_end();
 
 	kvfree(output_buffer.pixels);
 free_stage_buffer:
@@ -605,7 +618,7 @@ void vkms_composer_worker(struct work_struct *work)
 	struct drm_crtc *crtc = crtc_state->base.crtc;
 	struct vkms_writeback_job *active_wb = crtc_state->active_writeback;
 	struct vkms_output *out = drm_crtc_to_vkms_output(crtc);
-	bool crc_pending, wb_pending;
+	bool crc_pending, wb_pending, export;
 	u64 frame_start, frame_end;
 	u32 crc32 = 0;
 	int ret;
@@ -618,6 +631,8 @@ void vkms_composer_worker(struct work_struct *work)
 	crtc_state->frame_start = 0;
 	crtc_state->frame_end = 0;
 	crtc_state->crc_pending = false;
+	export = crtc_state->export_pending;
+	crtc_state->export_pending = false;
 
 	if (crtc->state->gamma_lut) {
 		s64 max_lut_index_fp;
@@ -644,9 +659,9 @@ void vkms_composer_worker(struct work_struct *work)
 		return;
 
 	if (wb_pending)
-		ret = compose_active_planes(active_wb, crtc_state, &crc32);
+		ret = compose_active_planes(active_wb, crtc_state, &crc32, export);
 	else
-		ret = compose_active_planes(NULL, crtc_state, &crc32);
+		ret = compose_active_planes(NULL, crtc_state, &crc32, export);
 
 	if (ret)
 		return;
@@ -661,6 +676,10 @@ void vkms_composer_worker(struct work_struct *work)
 	/*
 	 * The worker can fall behind the vblank hrtimer, make sure we catch up.
 	 */
+	/* Frames composed only for export have no CRC consumer. */
+	if (!out->composer_enabled)
+		return;
+
 	while (frame_start <= frame_end)
 		drm_crtc_add_crc_entry(crtc, true, frame_start++, &crc32);
 }
