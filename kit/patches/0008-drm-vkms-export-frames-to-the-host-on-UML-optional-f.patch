diff --git a/drivers/gpu/drm/vkms/vkms_export.c b/drivers/gpu/drm/vkms/vkms_export.c
new file mode 100644
index 000000000..aef68ea02
--- /dev/null
+++ b/drivers/gpu/drm/vkms/vkms_export.c
@@ -0,0 +1,103 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Frame export for User-Mode Linux.
+ *
+ * With vkms.export=<host path>, every frame that is committed to the CRTC is
+ * composed and written, as RGBA bytes, into a file on the host that the
+ * kernel maps shared. A viewer outside UML (on Android, the app hosting the
+ * VM) maps the same file and displays it.
+ *
+ * Layout: a 4 KiB header (struct vkms_export_header) followed by the pixels,
+ * width * 4 bytes per row. seq is odd while a frame is being written and is
+ * incremented again when the frame is complete.
+ */
+#include <linux/module.h>
+#include <linux/moduleparam.h>
+#include <linux/string.h>
+#include <drm/drm_fourcc.h>
+#include <asm/host_share.h>
+
+#include "vkms_drv.h"
+#include "vkms_export.h"
+
+#define VKMS_EXPORT_MAGIC	0x42464d55	/* "UMFB" */
+#define VKMS_EXPORT_HDR_SIZE	4096
+
+struct vkms_export_header {
+	u32 magic;
+	u32 version;
+	u32 width;
+	u32 height;
+	u32 stride;
+	u32 format;		/* DRM_FORMAT_ABGR8888: bytes R, G, B, A */
+	u64 seq;
+	u64 frames;
+};
+
+static char *export_path;
+module_param_named(export, export_path, charp, 0444);
+MODULE_PARM_DESC(export, "UML: host file that receives every displayed frame");
+
+static unsigned int export_mb = 16;
+module_param_named(export_mb, export_mb, uint, 0444);
+MODULE_PARM_DESC(export_mb, "UML: size of the frame export file in MiB");
+
+static struct vkms_export_header *export_hdr;
+static bool export_failed;
+
+bool vkms_export_enabled(void)
+{
+	return export_path && *export_path && !export_failed;
+}
+
+u8 *vkms_export_begin(u32 width, u32 height)
+{
+	unsigned long size = (unsigned long)export_mb << 20;
+
+	if (!vkms_export_enabled())
+		return NULL;
+	if (!export_hdr) {
+		export_hdr = uml_map_host_file(export_path, size);
+		if (!export_hdr) {
+			pr_err("vkms: cannot map frame export file %s\n", export_path);
+			export_failed = true;
+			return NULL;
+		}
+		memset(export_hdr, 0, sizeof(*export_hdr));
+		export_hdr->magic = VKMS_EXPORT_MAGIC;
+		export_hdr->version = 1;
+		export_hdr->format = DRM_FORMAT_ABGR8888;
+		pr_info("vkms: exporting frames to host file %s\n", export_path);
+	}
+	if (VKMS_EXPORT_HDR_SIZE + (unsigned long)width * height * 4 > size)
+		return NULL;
+
+	WRITE_ONCE(export_hdr->seq, export_hdr->seq + 1);
+	smp_wmb();
+	export_hdr->width = width;
+	export_hdr->height = height;
+	export_hdr->stride = width * 4;
+	return (u8 *)export_hdr + VKMS_EXPORT_HDR_SIZE;
+}
+
+void vkms_export_row(u8 *pixels, u32 width, int y, const struct line_buffer *line)
+{
+	u8 *dst = pixels + (size_t)y * width * 4;
+
+	for (size_t x = 0; x < line->n_pixels && x < width; x++) {
+		const struct pixel_argb_u16 *p = &line->pixels[x];
+
+		dst[0] = p->r >> 8;
+		dst[1] = p->g >> 8;
+		dst[2] = p->b >> 8;
+		dst[3] = 0xff;
+		dst += 4;
+	}
+}
+
+void vkms_export_end(void)
+{
+	export_hdr->frames++;
+	smp_wmb();
+	WRITE_ONCE(export_hdr->seq, export_hdr->seq + 1);
+}
diff --git a/drivers/gpu/drm/vkms/vkms_export.h b/drivers/gpu/drm/vkms/vkms_export.h
new file mode 100644
index 000000000..acf4c6064
--- /dev/null
+++ b/drivers/gpu/drm/vkms/vkms_export.h
@@ -0,0 +1,25 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+#ifndef _VKMS_EXPORT_H_
+#define _VKMS_EXPORT_H_
+
+#include <linux/types.h>
+
+struct line_buffer;
+
+/* Optional mode that replaces the default mode list (vkms.width/height). */
+extern unsigned int vkms_mode_width, vkms_mode_height;
+
+#ifdef CONFIG_UML
+bool vkms_export_enabled(void);
+u8 *vkms_export_begin(u32 width, u32 height);
+void vkms_export_row(u8 *pixels, u32 width, int y, const struct line_buffer *line);
+void vkms_export_end(void);
+#else
+static inline bool vkms_export_enabled(void) { return false; }
+static inline u8 *vkms_export_begin(u32 width, u32 height) { return NULL; }
+static inline void vkms_export_row(u8 *pixels, u32 width, int y,
+				   const struct line_buffer *line) { }
+static inline void vkms_export_end(void) { }
+#endif
+
+#endif /* _VKMS_EXPORT_H_ */
