+
+unsigned int vkms_mode_width;
+module_param_named(width, vkms_mode_width, uint, 0444);
+MODULE_PARM_DESC(width, "Width of the only display mode (0: default mode list)");
+
+unsigned int vkms_mode_height;
+module_param_named(height, vkms_mode_height, uint, 0444);
+MODULE_PARM_DESC(height, "Height of the only display mode (0: default mode list)");
 
 static enum drm_connector_status vkms_connector_detect(struct drm_connector *connector,
 						       bool force)
@@ -46,6 +57,19 @@ static int vkms_conn_get_modes(struct drm_connector *connector)
 {
 	int count;
 
+	/* A single mode of the requested size (a phone-shaped display, say). */
+	if (vkms_mode_width && vkms_mode_height) {
+		struct drm_display_mode *mode;
+
+		mode = drm_cvt_mode(connector->dev, vkms_mode_width, vkms_mode_height,
